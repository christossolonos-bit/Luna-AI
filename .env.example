# Copy to .env and fill in your values. Never commit .env to git.

# Discord
DISCORD_TOKEN=your_discord_bot_token

# Twitch
TWITCH_ACCESS_TOKEN=your_twitch_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_USERNAME=your_username
TWITCH_CHANNEL=your_channel

# Google API (for speech recognition, etc.) - keep secret, use env only
GOOGLE_API_KEY=your_google_api_key

# Optional: Ollama model override
# OLLAMA_MODEL=hf.co/subsectmusic/qwriko3-4b-instruct-2507-redux-GGUF:Q4_K_M
